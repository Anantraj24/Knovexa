{
  "name": "knovexa",
  "version": "0.1.0",
  "private": true,
  "description": "Intelligent knowledge workspace that transforms static documents into interactive, citation-grounded intelligence",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces"
  },
  "keywords": [
    "rag",
    "document-intelligence",
    "vector-search",
    "knowledge-base",
    "ai"
  ],
  "author": "Anantraj",
  "license": "MIT",
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
